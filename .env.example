# Gmail account used to SEND the alerts.
# Requires 2-Step Verification enabled, then an App Password generated at:
#   https://myaccount.google.com/apppasswords
# This is the 16-character app password, NOT your normal Google login password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Where alerts are delivered (can be the same as GMAIL_USER).
# Separate multiple recipients with commas — spaces around them are fine:
#   ALERT_EMAIL=you@gmail.com, someone@else.com
ALERT_EMAIL=lokesh.senthil@zohocorp.com

# How often to re-check every active tracker, in minutes.
CHECK_INTERVAL_MINUTES=15

# Web UI port.
PORT=3000

# --- Optional: use a different provider instead of Gmail ---
# Set SMTP_HOST to bypass the Gmail settings above (Zoho, Outlook, Mailgun, …).
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- District movie booking alerts ---
# Which District city to search movies and theatres in (the slug used in
# district.in URLs, e.g. chennai, bengaluru, hyderabad, mumbai, delhi-ncr).
DISTRICT_CITY=chennai

# How often to re-check every active movie watch, in minutes.
DISTRICT_CHECK_INTERVAL_MINUTES=10

# --- Deals view (products selling below their usual price) ---
# A deal is price < DEAL_RATIO x the product's own median recent price.
# 0.60 means "more than 40% below what it usually sells for".
DEAL_RATIO=0.60

# Price readings a product needs before we claim to know its usual price.
DEAL_MIN_OBSERVATIONS=5

# Trailing window the median is taken over, and how long readings are kept.
DEAL_WINDOW_DAYS=30
DEAL_RETENTION_DAYS=60

# How often to sweep the seed categories. 360 = every 6 hours.
DEAL_SWEEP_INTERVAL_MINUTES=360

# Individual emails per sweep; anything beyond this arrives as one digest.
DEAL_MAX_EMAILS_PER_SWEEP=10

# history | mrp.  Default "history" compares a product against its own past
# prices. "mrp" compares against Swiggy's listed MRP instead: it works from the
# very first sweep with no waiting, but Instamart MRPs are often inflated, so
# expect recurring alerts for products that are permanently "discounted".
DEAL_BASELINE=history

# Override the swept categories (comma separated). Empty = the built-in list
# in src/deals/seeds.js.
# DEAL_SEEDS=chocolate,shampoo,biscuits

# --- Tracker percentage-drop trigger ---
# A tracker alerts when EITHER its absolute target price is met, OR the price
# falls below this fraction of what the product usually costs (the median of
# its own price_history over 30 days). 0.60 = "more than 40% below usual".
# This catches drops an absolute target cannot: a Rs800 product halving to
# Rs400 never crosses a Rs60 target, but is clearly worth an email.
TRACKER_DROP_RATIO=0.60

# Readings a tracker needs before the drop rule applies to it.
TRACKER_MIN_OBSERVATIONS=5

# --- Deals sweep cadence ---
# Deep Instamart discounts are flash sales lasting ~30 minutes, so a 6-hourly
# sweep catches roughly 8% of them. During the hours when drops actually occur,
# sweep often enough to sample the window twice; outside them, just enough to
# keep baselines fresh. Times are IST.
DEAL_RUSH_START=08:00
DEAL_RUSH_END=22:00
DEAL_RUSH_INTERVAL_MINUTES=15

# Median window, and how long readings are kept. Retention must be >= window;
# the code clamps and warns if not. At the 15-minute rush cadence the catalogue
# records ~100k readings/day, so 14 days keeps the database ~4x smaller than
# the 60-day default while still giving a solid median.
DEAL_WINDOW_DAYS=14
DEAL_RETENTION_DAYS=14
